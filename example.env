# diablo-3 — example configuration.
# Copy to ".env" and fill in real values. NEVER commit your real .env.

# --- Network ---
# The server's IPv4 address as the players see it (announced in NAT discovery
# replies). Must be an IP address, not a hostname.
NEXTENDO_HOST=127.0.0.1
# Demonware auth (HTTPS). sni-router sends *.demonware.net here (BACKEND_D3).
AUTH_PORT=8460
# Set to 1 if this server sits behind a proxy that speaks the PROXY protocol
# (sni-router with SNI_PROXY_PROTOCOL=1): the auth then sees the player's IP.
NEXTENDO_PROXY_PROTOCOL=0
# Lobby (TCP) and NAT probes (UDP). The game uses 3074.
LOBBY_PORTS=3074,3075,3076,3077,3078,3079,3080
NAT_PORT=3074
# Optional listener address, for example 127.0.0.1 (empty = all interfaces).
BIND_ADDR=
# TLS cert/key for the auth endpoint (server-side; these are ignored by git).
CERT_FILE=cert.pem
KEY_FILE=key.pem

# --- Monitoring ---
# /api/stats for nextendo-dashboard (?key=DASH_TOKEN), /healthz, /pubfiles/.
DASH_PORT=8093
DASH_TOKEN=change-me
# SNI hostname advertised on the monitoring dashboard (cosmetic).
NEXTENDO_SNI_HOST=

# --- Diablo III ---
# Season, community events and blacklist are generated from this file.
D3_PUBFILES_CONFIG=pubfiles.json
D3_PUBFILES=pubfiles
# Raw captures of auth bodies and lobby frames: off, or a directory.
# Only written when NEXTENDO_REDACT_LOGS=0.
D3_DUMPS=off
# 1 = log every decrypted lobby message as a hex dump (withheld while logs are
# redacted).
D3_VERBOSE=0
# Challenge Rift blobs (challengerift_config.dat and challengerift_NN.dat, from
# d3hack's release zip: config/d3hack-nx/rift_data/). Not part of the repository.
# Without a challengerift_config.dat in this folder, rifts are not served.
D3_RIFTDATA=riftdata

# --- Crash Team Racing Nitro-Fueled on PS4 (CUSA13795, title 5760) ---
# shadNet trust policy (see config/auth.example.json). Required.
CTR_AUTH_CONFIG=
# RSA-2048 private key (PEM, exponent 65537) that signs auth replies. Required.
# Needs openssl on the PATH. The PS4 game accepts the signature only with the
# CTR:NF Server Signature Patch (see FORK.md).
CTR_AUTH_SIGNING_KEY=
# Persistent state (ctrnf.db: economy, leaderboards, player names).
DATA_DIR=data
# 1 = every Pit Stop item is owned and purchases debit nothing. The database
# records the mode and refuses the other one.
CTR_UNLOCK_ALL=0
# Wumpa Coins for a new account.
CTR_START_BALANCE=0
# 1 = also send the lobby migration message (off by default: the game then waits
# for a migration and closes after about 12 seconds).
CTR_MIGRATE=0
# Optional UDP relay inherited from upstream, not qualified for PS4 races:
# a port range (both set to enable) and the joiner account IDs it serves
# (comma-separated, or * for everyone).
CTR_RELAY_PORT_LOW=0
CTR_RELAY_PORT_HIGH=0
CTR_RELAY_PIDS=

# --- Diagnostics ---
# Logs keep only numbers and booleans by default; 0 = log full arguments and
# allow D3_DUMPS and D3_VERBOSE. They can then contain tickets, tokens and names.
NEXTENDO_REDACT_LOGS=1
