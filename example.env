# Nextendo Demonware for Crash Team Racing Nitro-Fueled on PS4: every setting.
#
# Settings are environment variables. Copy this file once per instance (for
# example normal.env and unlock-all.env, which git ignores), fill it in and
# either start `server -env normal.env` or let the deployment supply it
# (systemd EnvironmentFile=, docker --env-file). With -env, variables already
# in the process environment take precedence over the file. NEVER commit a
# filled-in copy.
#
# Format, as docker --env-file reads it: NAME=value, one per line; lines
# starting with # are comments. A value is everything after the first =, kept
# exactly: no quotes, and spaces are part of it. An empty value means the
# default. Switches accept 0 or false and 1 or true. The server reads
# everything once at startup and refuses to start, listing every problem, if
# a value is invalid, a required one is missing, or a CTR_, D3_, DASH_,
# NEXTENDO_ or SHADNET_ variable is not listed here.

# --- Network ---
# The server's IPv4 address as the players see it (announced in NAT discovery
# replies). Must be an IPv4 address, not a hostname.
NEXTENDO_HOST=127.0.0.1
# Optional listener address, for example 127.0.0.1 (empty = all interfaces).
BIND_ADDR=
# Demonware auth (HTTPS). sni-router sends *.demonware.net here (BACKEND_D3).
AUTH_PORT=8460
# 1 if this server sits behind a proxy that speaks the PROXY protocol
# (sni-router with SNI_PROXY_PROTOCOL=1): the auth then sees the player's IP.
NEXTENDO_PROXY_PROTOCOL=0
# Lobby (TCP) and NAT probes (UDP). The game uses 3074.
LOBBY_PORTS=3074,3075,3076,3077,3078,3079,3080
NAT_PORT=3074
# TLS certificate and key for the auth endpoint.
CERT_FILE=cert.pem
KEY_FILE=key.pem

# --- Publisher admission ---
# shadnet (default) verifies the account's NPAuth credential.
# guest assigns a new random ID/nickname per authentication, with no account.
# Guest admission requires CTR_UNLOCK_ALL=1 and empty SHADNET_* settings.
# Use a separate DATA_DIR: existing account databases refuse guest admission.
# The PS4 game still needs an account-free client path; this setting alone
# cannot bypass its platform checks. See FORK.md for validation status.
CTR_ADMISSION=shadnet
# central preserves the current server engine; steam requires local admission.
CTR_MATCHMAKING=central
# local admission requires inherited stdin/stdout from orbiSteamworks.
CTR_COMPANION=
# Plain HTTP auth is permitted only on direct loopback listeners.
CTR_AUTH_HTTP=0

# --- Steam trust (CTR_ADMISSION=steam only) ---
# Use a fresh DATA_DIR and empty SHADNET_* settings. The MIT orbiSteamworks
# helper is a separate executable, started here over private pipes. Its Valve
# runtime library is supplied by the operator, never bundled. AppID is 480.
# Realm contains 1-64 letters, digits, underscores or hyphens; clients must match.
# The helper has no public listener. Steam admission is verified; no API key.
CTR_STEAM_HELPER=
# Optional explicit steam_api64.dll / libsteam_api.so path; otherwise adjacent.
CTR_STEAM_LIBRARY=
CTR_STEAM_REALM=

# --- shadNet trust (required for shadnet admission only) ---
# The shadNet instance whose NPAuth ID tokens this server accepts: its issuer,
# the client and title registered there, the exact granted scopes (separated
# by spaces) and its public key set. For example:
#   SHADNET_ISSUER=https://identity.example.net
#   SHADNET_CLIENT_ID=example-application
#   SHADNET_TITLE_ID=CUSA13795
#   SHADNET_SCOPES=openid openid:duid
#   SHADNET_JWKS_URL=https://identity.example.net/.well-known/jwks.json
# The database records the issuer, client and title and refuses to open for
# another one.
SHADNET_ISSUER=
SHADNET_CLIENT_ID=
SHADNET_TITLE_ID=
SHADNET_SCOPES=
SHADNET_JWKS_URL=

# --- Crash Team Racing ---
# RSA-2048 private key (PEM, exponent 65537) that signs auth replies. Required.
# Needs openssl on the PATH. The PS4 game accepts the signature only with the
# CTR:NF Server Signature Patch (see FORK.md).
CTR_AUTH_SIGNING_KEY=
# Persistent state (ctrnf.db: economy, leaderboards, player names).
DATA_DIR=data
# 1 = every Pit Stop item is owned and purchases debit nothing. The database
# records the mode and refuses the other one.
CTR_UNLOCK_ALL=0
# Wumpa Coins for a new account.
CTR_START_BALANCE=0
# Main-menu news ticker (104/5); empty with no matching override = no message.
# Simplest setup: one default (for example English) plus only the translations
# you maintain. An English default needs no CTR_NEWS_EN duplicate. The game
# supplies its language; the server does not translate text automatically.
# End each text with a separator such as "   ***" (without quotes); the game
# repeats copies without a gap. Optional trailing spaces are preserved.
# The observed menu font displays the text in uppercase.
# Text is fixed per instance, independently of CTR_UNLOCK_ALL. Restart after
# changing it. One line of valid
# UTF-8, no control characters (including NUL, newline or tab), at most 2047
# bytes; the encoded JSON must be shorter than 4096 bytes. Line separators
# U+2028/U+2029 are refused too. Use clearly unofficial operator text.
CTR_NEWS=
# Optional overrides: exact game language, then CTR_NEWS (no English or base-
# language fallback). Empty overrides fall back too. Names use uppercase codes
# with '-' replaced by '_': pt-BR -> CTR_NEWS_PT_BR, es-MX -> CTR_NEWS_ES_MX.
# Only the following 28 overrides are accepted; unused lines may be omitted.
CTR_NEWS_AR=
CTR_NEWS_BG=
CTR_NEWS_ZH=
CTR_NEWS_CS=
CTR_NEWS_DA=
CTR_NEWS_NL=
CTR_NEWS_EN=
CTR_NEWS_FI=
CTR_NEWS_FR=
CTR_NEWS_DE=
CTR_NEWS_EL=
CTR_NEWS_HE=
CTR_NEWS_HI=
CTR_NEWS_HU=
CTR_NEWS_IT=
CTR_NEWS_JA=
CTR_NEWS_KO=
CTR_NEWS_NO=
CTR_NEWS_PL=
CTR_NEWS_PT=
CTR_NEWS_RU=
CTR_NEWS_ES=
CTR_NEWS_MX=
CTR_NEWS_SV=
CTR_NEWS_TA=
CTR_NEWS_TR=
CTR_NEWS_PT_BR=
CTR_NEWS_ES_MX=
# 1 = also send the lobby migration message (off by default: the game then waits
# for a migration and closes after about 12 seconds).
CTR_MIGRATE=0
# Optional UDP relay inherited from upstream, not qualified for PS4 races:
# a port range (both 0, or both set) and the joiner account IDs it serves
# (comma-separated, or * for everyone).
CTR_RELAY_PORT_LOW=0
CTR_RELAY_PORT_HIGH=0
CTR_RELAY_PIDS=

# --- Monitoring ---
# /api/stats for nextendo-dashboard (?key=DASH_TOKEN), and /healthz.
DASH_PORT=8093
DASH_TOKEN=change-me
# SNI hostname advertised on the monitoring dashboard (cosmetic).
NEXTENDO_SNI_HOST=

# --- Publisher files (legacy variable names retained) ---
# Accepted but inactive: the CTR executable never generates Diablo files.
D3_PUBFILES_CONFIG=pubfiles.json
# Generic CTR physical files for service 10/21; Diablo outputs/aliases excluded.
D3_PUBFILES=pubfiles
# Accepted but inactive: no Challenge Rift generation or serving in CTR.
D3_RIFTDATA=riftdata

# --- Diagnostics ---
# Logs keep only numbers and booleans by default; 0 or false = log full
# arguments and allow D3_DUMPS and D3_VERBOSE. They can then contain tickets,
# tokens and names.
NEXTENDO_REDACT_LOGS=1
# Raw captures of auth bodies and lobby frames: off, or a directory.
D3_DUMPS=off
# 1 = log every decrypted lobby message as a hex dump.
D3_VERBOSE=0
